# Egress rules for the instance containers, re-applied on every boot.
#
# The rules live in iptables only. A reboot takes them away and nothing fails when
# they are gone: the containers keep working, and the cloud metadata address and the
# private ranges are reachable again. That is the failure this unit exists for — it
# is silent, so it is the one that survives unnoticed.
#
# `egress.sh` deletes the rules it owns before adding them, so re-running it (boot,
# `systemctl reload`, after an edit) is safe and never stacks.
[Unit]
Description=geng egress rules for the agent-net bridge
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# @ROOT@ is the checkout; it is substituted at install time, like the other units.
ExecStart=@ROOT@/deploy/egress.sh agent-net
ExecReload=@ROOT@/deploy/egress.sh agent-net

[Install]
WantedBy=multi-user.target
