{
  "schema": 1,
  "runner": "local",
  "cycle": {
    "timeoutSec": 1800,
    "defaultWakeMinutes": 30,
    "minWakeMinutes": 1,
    "repeatThreshold": 3
  },
  "backup": {
    "enabled": true
  },
  "container": {
    "image": "geng-agent:latest",
    "memory": "2g",
    "cpus": "1.5",
    "pidsLimit": 512,
    "network": null,
    "proxyAllow": [
      "github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "proxy.golang.org",
      "sum.golang.org"
    ]
  },
  "files": {
    "maxAgeDays": 0,
    "maxMb": 500
  },
  "timezone": "Asia/Shanghai"
}
