{
  "schema": 1,
  "runner": "local",
  "cycle": {
    "timeoutSec": 1200,
    "defaultWakeMinutes": 30,
    "minWakeMinutes": 1,
    "repeatThreshold": 3
  },
  "backup": { "enabled": true },
  "packet": {
    "maxBytes": 8192
  },
  "container": {
    "image": "geng-agent:latest",
    "memory": "2g",
    "cpus": "1.5",
    "pidsLimit": 512,
    "network": null
  }
}
