{
  "schema": 1,
  "runner": "local",
  "cycle": {
    "timeoutSec": 1200,
    "defaultWakeMinutes": 30,
    "minWakeMinutes": 1,
    "repeatThreshold": 3
  },
  "backup": {
    "enabled": true
  },
  "container": {
    "image": "geng-agent:latest",
    "memory": "2g",
    "cpus": "1.5",
    "pidsLimit": 512,
    "network": null
  },
  "files": {
    "maxAgeDays": 0,
    "maxMb": 500
  }
}
