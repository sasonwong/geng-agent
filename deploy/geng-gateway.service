[Unit]
Description=geng gateway (message mover)
# A single bot token has exactly one update consumer, so there is exactly one
# gateway for every instance it serves.
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
# Telegram is not reachable from everywhere; node's fetch only honours
# HTTP(S)_PROXY when this is set. Harmless when no proxy is configured.
Environment=NODE_USE_ENV_PROXY=1
EnvironmentFile=-@ROOT@/secrets/gateway.env
ExecStart=@NODE@ @ROOT@/cmd/geng/index.ts gateway
Restart=always
RestartSec=10
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=default.target
