[Unit]
Description=geng github feeder timer (%i)

[Timer]
# Five minutes is chosen against the thing it watches, not against taste: a review or a
# red build is answered in minutes by a person, and a later poll only makes the delay
# longer. Each run is one `gh pr list` — no subscription, no webhook, no listener.
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=geng-feed@%i.service

[Install]
WantedBy=timers.target
