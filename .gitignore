# instance lives — never in git
/data/
/backup/
/secrets/

# 隐私审计报告为了说明"清掉了什么"，必然把值原样抄一遍——不进仓库
/audit/

# no trailing slash: a symlink is a file, and `/node_modules/` let one through
node_modules
/deploy/mail-worker/node_modules/
# wrangler's own scratch: never part of what Cloudflare runs
/deploy/mail-worker/.wrangler/
/deploy/mail-worker/.dev.vars
*.log
